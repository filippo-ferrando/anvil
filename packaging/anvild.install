generate_migrate_key() {
	if [ -f /var/lib/anvil/.ssh/id_ed25519 ]; then
		return 0
	fi
	install -d -m 700 /var/lib/anvil/.ssh
	ssh-keygen -t ed25519 -N "" -C anvil-migrate -f /var/lib/anvil/.ssh/id_ed25519 -q
	chown -R anvil:anvil /var/lib/anvil/.ssh
	chmod 700 /var/lib/anvil/.ssh
	chmod 600 /var/lib/anvil/.ssh/id_ed25519
	chmod 644 /var/lib/anvil/.ssh/id_ed25519.pub

	echo "==> Generated a passwordless SSH key for \`anvil migrate\` at:"
	echo "        /var/lib/anvil/.ssh/id_ed25519.pub"
	echo "==> Copy that public key into ~/.ssh/authorized_keys on any host you plan to"
	echo "    migrate to before using it. Adding a host with \`anvil host add\` does not"
	echo "    grant trust by itself, this is the actual key anvild connects with."
}

add_to_docker_group() {
	if getent group docker >/dev/null 2>&1; then
		gpasswd -a anvil docker >/dev/null
	else
		echo "==> Docker is not installed yet, so the anvil user was not added to the"
		echo "    docker group. Once you install docker, run:"
		echo "        gpasswd -a anvil docker && systemctl restart anvild"
	fi
}

post_install() {
	# Guarantee the "anvil" user/group and its directories exist right
	# now, synchronously — pacman's own systemd-sysusers/systemd-tmpfiles
	# hooks only run once, at the very end of the whole transaction,
	# which is too late for the rest of this script to depend on.
	systemd-sysusers anvil.conf
	systemd-tmpfiles --create anvil.conf

	generate_migrate_key
	add_to_docker_group

	echo "==> anvild now runs as the unprivileged anvil system user, not root."
	echo "==> See PLAN.md's M6 packaging notes for what that does and does not cover"
	echo "    (in particular: \`anvil mount\` now needs the anvil user to actually have"
	echo "    access to whatever host directory you share; root no longer bypasses that)."
}

post_upgrade() {
	systemd-sysusers anvil.conf
	systemd-tmpfiles --create anvil.conf

	# Defensive: pick up ownership left behind by an older build of this
	# package that ran anvild as root.
	chown -R anvil:anvil /var/lib/anvil /var/cache/anvil 2>/dev/null || true

	generate_migrate_key
	add_to_docker_group
}

# Deliberately no post_remove/pre_remove: the "anvil" user, its home
# directory, and its migration SSH key are left in place on removal,
# matching how most Arch packages that create a system user (postgresql,
# for one) leave that user and its data alone rather than deleting it —
# removing anvild isn't a signal that its VMs/instances/migration key
# should be destroyed too.
