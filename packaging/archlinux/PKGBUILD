# Maintainer: filippo ferrando <ferrandodfilippo@ik.me>
pkgbase=anvil
pkgname=('anvil' 'anvild')
pkgver=0.1.0
pkgrel=1
pkgdesc="Multipass-alike for cloud-init VMs and Docker/Podman containers"
arch=('x86_64')
url="https://git.fferrando.cc/rdfilippo/anvil"
license=('Apache-2.0')
makedepends=('go' 'git')
# makepkg.conf enables "debug" by default, which adds an unwanted anvil-debug package.
options=('!debug')
source=("anvil::git+https://git.fferrando.cc/rdfilippo/anvil.git")
sha256sums=('SKIP') # VCS source, no fixed download to checksum

build() {
  cd "$srcdir/anvil"
  CGO_ENABLED=0 go build -trimpath -mod=readonly -o "$srcdir/anvil-bin" ./cmd/anvil
  go build -trimpath -mod=readonly -o "$srcdir/anvild-bin" ./cmd/anvild
}

package_anvil() {
  pkgdesc="CLI for anvil, a Multipass-alike for cloud-init VMs and containers"
  depends=('openssh')

  install -Dm755 "$srcdir/anvil-bin" "$pkgdir/usr/bin/anvil"

  install -Dm644 <("$srcdir/anvil-bin" completion bash) "$pkgdir/usr/share/bash-completion/completions/anvil"
  install -Dm644 <("$srcdir/anvil-bin" completion zsh) "$pkgdir/usr/share/zsh/site-functions/_anvil"
  install -Dm644 <("$srcdir/anvil-bin" completion fish) "$pkgdir/usr/share/fish/vendor_completions.d/anvil.fish"

  # One page per subcommand, generated by the hidden `anvil man` command
  # (internal/cli/commands/man.go) straight from the live command tree;
  # makepkg's own compressman feature gzips these afterward.
  install -d "$pkgdir/usr/share/man/man1"
  "$srcdir/anvil-bin" man "$pkgdir/usr/share/man/man1"

  install -Dm644 "$srcdir/anvil/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}

package_anvild() {
  pkgdesc="Daemon for anvil - manages QEMU VMs and Docker/Podman containers"
  depends=('qemu-base' 'xorriso' 'openssh')
  optdepends=(
    'docker: run containers via Docker'
    'podman: run containers via Podman (backend not implemented yet)'
  )

  install=anvild.install

  install -Dm755 "$srcdir/anvild-bin" "$pkgdir/usr/bin/anvild"
  # The systemd unit, sysusers/tmpfiles configs, and post-install script
  # are all shared verbatim across every packaging format (packaging/deb,
  # packaging/rpm too), not duplicated per format (see packaging/common/).
  install -Dm644 "$startdir/../common/anvild.service" "$pkgdir/usr/lib/systemd/system/anvild.service"
  install -Dm644 "$startdir/../common/anvil.sysusers" "$pkgdir/usr/lib/sysusers.d/anvil.conf"
  install -Dm644 "$startdir/../common/anvil.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/anvil.conf"
  install -Dm755 "$startdir/../common/post-install.sh" "$pkgdir/usr/lib/anvil/post-install.sh"
  # Referenced from anvild.install's pre_remove, not post_remove: pacman
  # deletes a package's own files before running post_remove, so this
  # script has to still be on disk when it's invoked, same reasoning
  # packaging/deb/build.sh inlines this file's content into DEBIAN/postrm
  # instead of shipping it as a regular file there.
  install -Dm755 "$startdir/../common/purge.sh" "$pkgdir/usr/lib/anvil/purge.sh"
  # Hand-written, not generated: anvild takes no flags/subcommands, so
  # there's no cobra command tree for `anvil man`'s equivalent to walk.
  install -Dm644 "$srcdir/anvil/docs/man/anvild.8" "$pkgdir/usr/share/man/man8/anvild.8"
  install -Dm644 "$srcdir/anvil/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
