[Unit]
Description=anvil daemon (cloud-init VMs and Docker containers)
After=network.target anvil-devhelper.socket
Wants=anvil-devhelper.socket

# Runs as the unprivileged "anvil" system user (created by anvil.sysusers,
# in this same directory), with just enough grants for KVM and tap/bridge
# networking; Docker group membership, if applicable, is added separately
# by each package format's own post-install step (archlinux/anvild.install,
# deb/postinst-anvild, rpm/anvil.spec.in's %post).
#
# This file (and its two siblings here) is shared verbatim across every
# packaging format under packaging/. Never copy it, reference this one.
[Service]
Type=simple
User=anvil
Group=anvil
SupplementaryGroups=kvm
ExecStart=/usr/bin/anvild
Restart=on-failure
RestartSec=2
# Only anvild itself is stopped on a restart or upgrade: QEMU and virtiofsd keep running
# and the new anvild attaches to them again. At host shutdown they still get stopped.
KillMode=process

# Runs as root ("+"): copies Firecracker's jailer with its capabilities as file capabilities,
# so neither anvild nor firecracker holds them. See docs/security.md.
ExecStartPre=+/usr/lib/anvil/prepare-jailer.sh
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# The jailer's file capabilities only work inside the bounding set.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_CHOWN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
# "m": the jailer creates these device nodes inside each chroot.
DeviceAllow=/dev/kvm rwm
DeviceAllow=/dev/net/tun rwm
DeviceAllow=/dev/userfaultfd rwm
# USB/PCI passthrough: QEMU opens the device files anvil-devhelper hands over.
DeviceAllow=char-usb_device rw
DeviceAllow=char-vfio rw
DeviceAllow=/dev/vfio/vfio rw
# VFIO pins all guest RAM of a VM with PCI devices; QEMU inherits this limit.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
