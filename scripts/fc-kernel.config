# anvil additions on top of Firecracker's microvm-kernel-ci-<arch>-6.18.config, merged by
# scripts/build-fc-kernel.sh. Everything is built in: no modules ship with the kernel.

# Partitioned cloud images: the root drive is found by GPT/MBR PARTUUID.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Root filesystems of the catalog distros, and what their fstab mounts.
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# The cloud-init seed drive is an ISO9660 image labelled cidata.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# `anvil mount` is served over NFSv3.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y

# Guest agent over vsock, virtio-mem for live memory changes.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_MEM=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y

# Firecracker's SendCtrlAltDel goes through an emulated i8042 keyboard (x86_64 only).
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# Containers and VPNs inside the guest; netfilter, nf_tables, bridge and veth come from the base config.
CONFIG_OVERLAY_FS=y
CONFIG_WIREGUARD=y

# `zcat /proc/config.gz` tells what this kernel has.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-anvil"

# Ephemeral clones: free page reporting gives memory a guest frees back to the host, and
# VMGenID reseeds the kernel RNG on every snapshot restore. Both are in Firecracker's base
# config; pinned here so the build fails if one goes missing.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_VMGENID=y
